DATABASE_URL=postgresql://gallery:change-me@127.0.0.1:5433/gallery
UPLOAD_DIR=./data/uploads
# Set these for single-owner login. See README before exposing the app.
APP_PASSWORD=
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
# Production only: explicitly opt into a trusted private network without login.
ALLOW_PRIVATE_NO_AUTH=false
# Compose-only settings. Use a URL-safe random hex database password.
POSTGRES_PASSWORD=
BIND_ADDRESS=127.0.0.1
APP_PORT=3000
