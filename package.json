{
  "name": "open-prompt-gallery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:db": "RUN_DB_TESTS=1 npm test",
    "format": "prettier --write .",
    "storage:cleanup": "node --env-file-if-exists=.env scripts/cleanup.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "pm2": "^7.0.4",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "js-yaml": "^4.3.2"
  }
}
